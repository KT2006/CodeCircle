# CodeCircle — Server Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# ── General ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (Postgres 16) ────────────────────────────────────────────────────
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# docker-compose exposes Postgres on localhost:5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/codecircle

# ── Redis ────────────────────────────────────────────────────────────────────
# docker-compose exposes Redis on localhost:6379
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters — use: openssl rand -hex 32
JWT_SECRET=replace_me_with_a_32_char_secret_string

# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── CORS (development only) ───────────────────────────────────────────────────
# In production the frontend is same-origin via Vercel rewrite — CORS is not needed
CORS_ORIGIN=http://localhost:5173

# ── Refresh / staleness tunables (plan §2A D2/D3, §2B P2/P3) ─────────────────
# Minimum minutes between refreshes for the same handle
REFRESH_COOLDOWN_MINUTES=15

# Minutes after which a snapshot is considered stale (6 hours)
STALE_AFTER_MINUTES=360

# Number of retry attempts for a failing sync job
SYNC_JOB_ATTEMPTS=3

# Minutes before a stuck queued/fetching status is ignored by the gate
STUCK_JOB_MINUTES=10

# ── Feature limits ────────────────────────────────────────────────────────────
MAX_FRIENDS_PER_USER=50

# ── Worker mode ───────────────────────────────────────────────────────────────
# 'separate' — worker runs as its own process (worker.js); recommended for prod
# 'inline'   — worker runs inside the API process; use on free hosting tiers
WORKER_MODE=separate

# ── LLM (Phase 8 only — leave blank until then) ───────────────────────────────
# ANTHROPIC_API_KEY=
